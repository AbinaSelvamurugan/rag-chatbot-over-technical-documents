# Copy to .env. Never commit real credentials.
GROQ_API_KEY=
# Verify model availability for your account using GET /models. Example production ID listed by Groq Oct 2026:
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
COLLECTION_NAME=technicaldocs
CHUNK_SIZE=1100
CHUNK_OVERLAP=150
RETRIEVAL_K=8
CONTEXT_K=5
MAX_CONTEXT_CHARS=12000
RETRIEVAL_STRATEGY=dense
# Optional model for CrossEncoder reranking; downloads separately, can be expensive:
RERANKER_MODEL=
# Leave empty only for loopback-only local development.
ADMIN_TOKEN=
ALLOW_URL_INGESTION=false
ALLOWED_HOSTS=www.juniper.net
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
LOG_LEVEL=INFO
